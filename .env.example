# PostgreSQL Configuration
DB_PASSWORD=changeme
DATABASE_URL=postgresql://triagebot:changeme@localhost:5432/langgraph

# Gitea Configuration
GITEA_URL=http://localhost:3000
GITEA_TOKEN=your_gitea_api_token_here
GITEA_REPO_OWNER=triagebot
GITEA_REPO_NAME=bug-reports

# OpenAI API
OPENAI_API_KEY=sk-proj-your-key-here

# LangSmith Tracing (Optional)
LANGSMITH_API_KEY=lsv2_pt_your-key-here
LANGSMITH_PROJECT=bug-triage-dev
LANGSMITH_TRACING=true
LANGSMITH_SAMPLING_RATE=0.1

# Rate limiting (POST /api/triage)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development
